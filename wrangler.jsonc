// SG16 Identifier on Cloudflare Workers: the Vite + React single-page app as static assets,
// served and backed by the Worker in src/worker/index.ts (API, page metadata, image resizing).
// Dev: npm run dev   Local production preview: npm run preview   Deploy: npm run deploy
// `vite build` writes the deployable config to dist/; `wrangler deploy` picks it up automatically.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sg16-identifier",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-10-23",
	// nodejs_compat is needed by the PostgreSQL driver (pg), as Cloudflare documents for Hyperdrive,
	// and provides AsyncLocalStorage. App code imports no node:fs/dns/tls/net.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		// Filled from Vite's client build at build time.
		"binding": "ASSETS",
		// Unknown paths still load the app (it renders its own not-found page).
		"not_found_handling": "single-page-application",
		// Page and API URLs go to the Worker first (metadata, 404 status, API). Built assets,
		// public files and, in `vite dev`, Vite's own module URLs are served directly.
		"run_worker_first": ["/*", "!/assets/*", "!/src/*", "!/node_modules/*", "!/@*"]
	},
	// Image resizing and AVIF/WebP for /api/image (header logo, Robo Manager).
	"images": {
		"binding": "IMAGES"
	},
	// Rate limits and the daily budget, shared by every Worker instance (src/worker/guard.ts).
	"durable_objects": {
		"bindings": [{ "name": "GUARD", "class_name": "GuardState" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuardState"] }],
	"observability": {
		"enabled": true
	}
	// Optional bindings the app detects at runtime:
	//   "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id from `npx wrangler hyperdrive create`>" }]
	//       Pools PostgreSQL connections at the edge; used instead of DATABASE_URL when bound.
	//   "ai": { "binding": "AI" }
	//       Workers AI for the universal API (model ids "workers-ai/@cf/..."). It always calls
	//       Cloudflare's network, so `npm run dev` then needs `npx wrangler login`.
	//
	// Secrets (DATABASE_URL, ADMIN_ACCESS_CODE, VITEX_GATEWAY_KEYS, provider API keys) are set
	// with `npx wrangler secret put <NAME>`, never written here; .dev.vars holds them locally.
}
