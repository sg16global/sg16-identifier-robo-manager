# Local development reads these from .dev.vars (copy this file); production values are
# Worker secrets: npx wrangler secret put <NAME>

# --- required ---------------------------------------------------------------
# PostgreSQL. In production, bind Hyperdrive (wrangler.jsonc) and it is used instead.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- operator ---------------------------------------------------------------
# Code required by /api/admin; while empty the console is closed to everyone. Use a long
# random value (e.g. `openssl rand -hex 24`), set it with `wrangler secret put` in production.
ADMIN_ACCESS_CODE=
# Days before a stored report is deleted (privacy default).
SG16_RETENTION_DAYS=30
# Hard daily ceiling on metered variable cost, in USD.
SG16_DAILY_BUDGET_USD=12
# Set to false to disable DNS/TLS intelligence lookups.
SG16_ENABLE_DNS=true

# --- optional provider adapters (each enables one evidence source) ----------
# Google Fact Check Tools API — existing ClaimReviews for news & claim checks.
GOOGLE_FACTCHECK_API_KEY=
# Google Web Risk (commercial) or Safe Browsing — URL reputation.
WEB_RISK_API_KEY=
SAFE_BROWSING_API_KEY=
# AI claim extraction, evidence comparison and summary drafting. Any provider in
# the Vitex section below works; these OpenAI-compatible settings are kept as-is.
OPENAI_API_KEY=
SG16_AI_MODEL=gpt-4o-mini
SG16_AI_BASE_URL=https://api.openai.com/v1
# Metering rates per million tokens; the default for every provider (see VITEX_PROVIDERS).
SG16_AI_INPUT_PRICE_PER_M=0.05
SG16_AI_OUTPUT_PRICE_PER_M=0.25
# Certificate Transparency fallback (Cert Spotter) for TLS certificate checks. Optional:
# works without a key at a lower hourly quota; crt.sh is always tried first.
CERTSPOTTER_API_KEY=
# Licensed web search — pick one.
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_KEY=

# Live source for the homepage AI Pioneers rail (an SG16 page rendering .pioneer-card blocks)
PIONEERS_SOURCE_URL=https://mistralbrain.com/

# --- Vitex universal API (/v1) ------------------------------------------------
# API keys for /v1/* (comma or space separated, 16+ characters each). Empty = API closed.
VITEX_GATEWAY_KEYS=
# Requests per minute per key (default 120).
VITEX_GATEWAY_RPM=120
# Browser origins allowed to call /v1 ("*" or a comma list). Empty = server-to-server only.
VITEX_CORS_ORIGINS=
# Callers can reach any company's server without configuration:
#   transparent: any /v1/<path> with x-vitex-base-url is forwarded untouched to <base-url>/<path>
#   (gateway key in x-vitex-key; the caller's own Authorization or x-vitex-api-key goes to the server)
#   any HTTP API by full URL: /v1/forward with x-vitex-target (or ?url=)
# Such caller-supplied URLs must be public unless this is true (also reaches private/internal hosts).
VITEX_ALLOW_PRIVATE_TARGETS=false

# Model providers: setting a key enables it. Models are addressed as <provider>/<model>.
# <PROVIDER>_BASE_URL (e.g. ANTHROPIC_BASE_URL) points one at a proxy or Cloudflare AI Gateway.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
# Azure OpenAI needs both (base URL like https://<resource>.openai.azure.com/openai/v1).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
# Workers AI: bind "ai" in wrangler.jsonc (no key), or use the REST API with both of these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model used when a request names none (default: the first configured provider's default).
VITEX_DEFAULT_MODEL=
VITEX_DEFAULT_PROVIDER=

# Any other server, public, internal or local: one speaking the openai, anthropic or gemini
# protocol, or ANY JSON API via "protocol":"custom" (request template + response paths;
# placeholders {{model}} {{messages}} {{prompt}} {{system}} {{last_user}} {{max_tokens}}
# {{temperature}} {{top_p}} {{stop}}). Secrets by env-var name only; ${NAME} also works inside
# baseUrl, headers and query values. An entry whose id matches a built-in provider extends it.
# VITEX_PROVIDERS=[{"id":"acme","protocol":"openai","baseUrl":"https://llm.acme.com/v1","apiKeyEnv":"ACME_LLM_KEY","models":["acme-large"]},{"id":"ollama","protocol":"openai","baseUrl":"http://localhost:11434/v1"},{"id":"acmeml","protocol":"custom","baseUrl":"https://ml.acme.com","path":"/v2/generate","apiKeyEnv":"ACME_ML_KEY","requestTemplate":{"input":"{{prompt}}","max_new_tokens":"{{max_tokens}}"},"responseMap":{"content":"result.text","promptTokens":"usage.in","completionTokens":"usage.out"}}]
VITEX_PROVIDERS=

# Company APIs reachable through /v1/proxy/<id>/<path>; the credential is attached server-side.
# auth types: none | bearer {secretEnv} | header {name, secretEnv} | query {param, secretEnv} | basic {usernameEnv, passwordEnv}
# VITEX_UPSTREAMS={"crm":{"baseUrl":"https://api.acme.com/v2","auth":{"type":"bearer","secretEnv":"ACME_CRM_TOKEN"},"methods":["GET","POST"],"timeoutMs":30000}}
VITEX_UPSTREAMS=
