# Universal verification engine — operator configuration.
#
# Local development reads these from .dev.vars (copy this file); production values
# are Worker secrets: npx wrangler secret put <NAME>
#
# The whole point of this project is that NOTHING here names a company. Every
# provider, evidence source, brand list and display name is yours to fill in —
# or to leave empty, in which case the matching capability reports itself as
# "not configured on this deployment" instead of failing.

# --- required ---------------------------------------------------------------
# PostgreSQL. In production, bind Hyperdrive (wrangler.jsonc) and it is used instead.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Code required by /api/admin (x-admin-code header); while empty the console is
# closed to everyone. Use a long random value (e.g. `openssl rand -hex 24`).
ADMIN_ACCESS_CODE=

# --- identity (defaults: neutral, unbranded) ---------------------------------
APP_NAME=Universal Identifier
APP_SHORT_NAME=Identifier
APP_TAGLINE=Evidence before conclusion
# One-sentence description used in page metadata and the footer.
APP_DESCRIPTION=
# Comma-separated SEO keywords.
APP_KEYWORDS=
# Canonical origin, e.g. https://example.org — used for og:url, bots and cache keys.
SITE_URL=
# Machine-readable service id reported by /api/health.
SERVICE_NAME=universal-identifier
# Name of the voice/chat assistant mascot.
ROBO_NAME=Robo Manager
# Public report references read <PREFIX>-XXXX-XXXX.
REPORT_ID_PREFIX=RPT
# Outbound fetches identify themselves with this user agent.
BOT_USER_AGENT=

# --- operating entity (footer contact block; hidden unless ORG_ENTITY is set) -
ORG_ENTITY=
ORG_TYPE=
ORG_JURISDICTION=
ORG_REGISTRATION=
ORG_FORMED=
ORG_WEBSITE=
ORG_WEBSITE_LABEL=
ORG_EMAIL=
# URL of the public register where ORG_REGISTRATION can be confirmed.
ORG_REGISTRY=

# --- certificate viewer (footer; hidden unless an image is supplied) ---------
# base64 (or data: URL) image; served only through /api/legal/certificate and
# painted client-side with a watermark. Never exposed as a static asset.
CERTIFICATE_IMAGE=
CERTIFICATE_MIME=image/webp

# --- decorative rails (each section hides itself when unconfigured) ----------
# Live card rail scraped from any page you name; card/name/role are CSS classes
# on that page (defaults match a generic card layout).
SHOWCASE_SOURCE_URL=
SHOWCASE_TITLE=Live Showcase
SHOWCASE_SUBTITLE=
SHOWCASE_CARD_CLASS=pioneer-card
SHOWCASE_NAME_CLASS=pioneer-name
SHOWCASE_ROLE_CLASS=pioneer-role
# Rolling name rail: JSON [{"name":"…","note":"…"}]
RAIL_ITEMS=
# Flags strip: JSON [{"name":"…","flag":"us"}] (built-in flags: us gb fr ru cn de)
# or [{"name":"…","image":"https://…/flag.svg"}] for any other emblem.
PRESENCE_ITEMS=

# --- operations ---------------------------------------------------------------
# Days before a stored report is deleted (default 30).
RETENTION_DAYS=30
# Hard daily ceiling on metered variable cost, in USD (default 12).
DAILY_BUDGET_USD=12
# Set to false to disable DNS/TLS intelligence lookups.
ENABLE_DNS=true
# DNS-over-HTTPS resolvers (comma-separated URLs). Empty = DNS intelligence off,
# reported honestly in the affected results.
DNS_RESOLVERS=

# --- AI adapter (one model server, anywhere) ----------------------------------
# Wire protocol: chat-completions | messages | generate-content | binding | custom
# (the three open chat wire formats, a Workers AI binding, or ANY JSON API via
# a custom request template). Auth defaults to the standard bearer channel; a
# server that expects a dedicated key header or a query key is described with
# AI_AUTH_HEADER / AI_AUTH_SCHEME / AI_AUTH_QUERY — configuration, not code.
AI_PROTOCOL=chat-completions
AI_BASE_URL=
# Secret by environment-variable NAME only; the value itself never appears here.
AI_API_KEY=
AI_MODEL=
# Auth shape when the provider differs from the protocol default.
AI_AUTH_HEADER=
AI_AUTH_SCHEME=bearer
AI_AUTH_QUERY=
# Cloudflare binding name (e.g. AI) instead of an HTTP endpoint.
AI_BINDING=
# Human label shown in the operator console, and the provider id used in <id>/<model>.
AI_LABEL=
AI_PROVIDER_ID=default
# Metering rates per million tokens for the cost model (defaults 0.05 / 0.25).
AI_INPUT_PRICE_PER_M=0.05
AI_OUTPUT_PRICE_PER_M=0.25

# --- universal /v1 gateway -----------------------------------------------------
# API keys for /v1/* (comma or space separated, 16+ characters each). Empty = API closed.
GATEWAY_API_KEYS=
# Requests per minute per key (default 120).
GATEWAY_RPM=120
# Browser origins allowed to call /v1 ("*" or a comma list). Empty = server-to-server only.
GATEWAY_CORS_ORIGINS=
# Callers can reach any server in the world without configuration:
#   transparent: any /v1/<path> with x-gateway-base-url is forwarded untouched to <base-url>/<path>
#   (gateway key in x-gateway-key; the caller's own Authorization or x-gateway-api-key goes to the server)
#   any HTTP API by full URL: /v1/forward with x-gateway-target (or ?url=)
# Such caller-supplied URLs must be public unless this is true (also reaches private/internal hosts).
GATEWAY_ALLOW_PRIVATE_TARGETS=false
# Extra request headers stripped before a configured upstream's own credential
# is attached (comma list). The default drop-set is only the standard bearer
# channel plus the header the upstream's own auth config names: every other
# header, however your API brands it, passes through untouched.
GATEWAY_DROP_HEADERS=
# Model used when a request names none (default: the first configured provider's default).
DEFAULT_MODEL=
DEFAULT_PROVIDER=

# Any other model server, public, internal or local: one speaking the
# chat-completions, messages or generate-content wire protocol, or ANY JSON API
# via "protocol":"custom" (request
# template + response paths; placeholders {{model}} {{messages}} {{prompt}}
# {{system}} {{last_user}} {{max_tokens}} {{temperature}} {{top_p}} {{stop}}).
# Secrets by env-var name only; ${NAME} also works inside baseUrl, headers and
# query values. An entry whose id matches an existing provider extends it.
# MODEL_PROVIDERS=[{"id":"acme","protocol":"chat-completions","baseUrl":"https://llm.acme.com/v1","apiKeyEnv":"ACME_LLM_KEY","models":["acme-large"]},{"id":"local","protocol":"chat-completions","baseUrl":"http://localhost:11434/v1"},{"id":"acmeml","protocol":"custom","baseUrl":"https://ml.acme.com","path":"/v2/generate","apiKeyEnv":"ACME_ML_KEY","requestTemplate":{"input":"{{prompt}}","max_new_tokens":"{{max_tokens}}"},"responseMap":{"content":"result.text","promptTokens":"usage.in","completionTokens":"usage.out"}}]
MODEL_PROVIDERS=

# Company APIs reachable through /v1/proxy/<id>/<path>; the credential is attached server-side.
# auth types: none | bearer {secretEnv} | header {name, secretEnv} | query {param, secretEnv} | basic {usernameEnv, passwordEnv}
# API_UPSTREAMS={"crm":{"baseUrl":"https://api.example.com/v2","auth":{"type":"bearer","secretEnv":"CRM_TOKEN"},"methods":["GET","POST"],"timeoutMs":30000}}
API_UPSTREAMS=

# --- evidence connectors (capability slots; empty = honest "not configured") ---
# Each is a JSON list of declarative HTTP calls — any JSON API, in any region:
#   {"id":"search-one","label":"Primary search","method":"POST",
#    "url":"https://search.example.net/api?q={{query}}","headers":{"x-key":"${SEARCH_KEY}"},
#    "body":{"q":"{{query}}","n":"{{max_results}}"},
#    "responseMap":{"results":"data.hits","title":"heading","url":"link","snippet":"body"},
#    "timeoutMs":10000,"costPerCallUsd":0.004}
# Placeholders: {{query}} {{url}} {{hostname}} {{identity}} {{wildcard}}
#               {{max_results}} {{page_size}} {{language}}   — secrets as ${ENV}.
SEARCH_CONNECTORS=
FACTCHECK_CONNECTORS=
REPUTATION_CONNECTORS=
CT_CONNECTORS=

# --- media forensics signatures (operator vocabulary) --------------------------
# Standards markers (IPTC digitalSourceType, C2PA generative assertions) and
# structural signals (embedded generation parameters, declared software) are
# built in and vendor-neutral. Brand-shaped patterns are configuration:
# MEDIA_SIGNATURES=[{"pattern":"sovereign[- ]?brain","label":"Sovereign Brain suite","kind":"generator"},{"pattern":"acme[- ]?retouch","label":"Acme Retouch","kind":"edit"}]
MEDIA_SIGNATURES=

# --- trust lists & lexicon (operator vocabulary) -------------------------------
# Extra structural suffixes treated as official (comma list).
OFFICIAL_DOMAIN_SUFFIXES=
# Domains this deployment rates as reputable (comma list).
REPUTABLE_DOMAINS=
# User-generated / social domains rated "mixed" (comma list).
MIXED_TRUST_DOMAINS=
SHORTENER_HOSTS=
FREE_HOST_DOMAINS=
# Payment-pressure phrases (comma list).
PAYMENT_TERMS=
# Brand terms whose impersonation matters (comma list).
PROTECTED_BRANDS=
# JSON {"payment":[…],"messenger":[…],"remoteAccess":[…],"brands":[…]}
SIGNAL_TERMS=

# --- product catalogue ---------------------------------------------------------
# Seed entries (JSON, source "operator-config"); the admin console can upsert,
# delete and import more at runtime. RETAILER_SEARCH_URL is a URL template with
# {{query}} used for "compare with official sources" links.
PRODUCT_CATALOG=
RETAILER_SEARCH_URL=
